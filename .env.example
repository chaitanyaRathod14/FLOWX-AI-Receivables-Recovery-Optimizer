# ==========================================
# FLOWX Environment Variables Reference
# ==========================================

# --- Frontend (Vercel) Environment Variables ---
# Set this in Vercel Dashboard -> Settings -> Environment Variables
# Replace with your deployed Render backend URL (no trailing slash needed)
NEXT_PUBLIC_API_URL=https://flowx-backend.onrender.com

# --- Backend (Render) Environment Variables ---
# Set these in Render Dashboard -> Environment
PYTHON_VERSION=3.11.9
DEMO_MODE=true
FLOWX_JWT_SECRET=your-random-secure-secret-key-32-chars
CORS_ORIGINS=http://localhost:3000,https://flowx-frontend.vercel.app
FLOWX_DB=backend/app/flowx.db
