# Production environment variables for deployment
# Copy this to .env.production and replace all placeholders
NEXT_PUBLIC_API_URL=https://your-render-backend-url.onrender.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

PYTHON_VERSION=3.11.9
DEMO_MODE=false
FLOWX_JWT_SECRET=replace-with-a-long-random-secret-key
CORS_ORIGINS=https://your-frontend-domain.vercel.app

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:replace-with-your-supabase-password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:replace-with-your-supabase-password@db.your-project-ref.supabase.co:5432/postgres
